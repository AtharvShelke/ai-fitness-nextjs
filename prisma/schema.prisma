generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UsedEmail {
  id         String   @id @default(uuid())
  email      String   @unique
  hasUsedWorkout Boolean @default(false)
  hasUsedDiet    Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
