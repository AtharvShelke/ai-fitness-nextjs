generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Tier {
  FREE
  BASIC
  ELITE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  plans         GeneratedPlan[]
  planHistory   PlanHistory[]
  tokenLogs     TokenTransaction[]

  // ── Existing biometric/goal fields ──────────────────────────────
  height        Float?
  weight        Float?
  age           Int?
  gender        String?
  goal          String?

  // ── NEW: constraint / token system fields ───────────────────────
  tier                 Tier      @default(FREE)
  tokenBalance         Int       @default(3)
  billingCycleEndsAt   DateTime?

  // ── NEW: extended profile fields (all optional for backward compat)
  targetWeight     Float?
  timeline         String?
  fitnessLevel     String?
  activityLevel    String?
  sessionDuration  String?
  trainingLocation String?
  sleepDuration    String?
  stressLevel      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model GeneratedPlan {
  id        String @id @default(cuid())
  userId    String
  type      String
  data      Json
  inputData Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Versioned AI generation history ─────────────────────────────────────────
model PlanHistory {
  id            String  @id @default(cuid())
  userId        String
  versionNumber Int // per-user monotonic counter (1, 2, 3 …)
  planType      String // "workout" | "diet"
  inputSnapshot Json // exact user inputs captured at generation time
  aiResponse    Json // full structured AI output (WorkoutPlan | DietPlan)
  inputHash     String? // sha256(planType + canonicalised inputs) — optional dedup key

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, versionNumber])
  @@index([userId, createdAt(sort: Desc)])
  @@index([inputHash])
}

model TokenTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount      Int      
  type        String   
  description String?  
  
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Persistent Global Cache for AI Generations ────────────────────────────────
model GlobalGenerationCache {
  id            String   @id @default(cuid())
  inputHash     String   @unique  // SHA-256 hash of the exact sanitized inputs + plan type
  planType      String   // "diet" | "workout"
  aiResponse    String   // The full JSON string response to deliver
  
  hitCount      Int      @default(0)
  createdAt     DateTime @default(now())
  lastHitAt     DateTime @default(now())
  
  @@index([inputHash])
}
